# Образец конфигурации «Контур КП». Скопируйте в .env (не коммитится) и заполните.
# Проверка без вывода значений: npm run config:check

KONTUR_ENV=development

# Роль приложения kontur_app (DML без DDL)
DATABASE_URL=postgresql://kontur_app@127.0.0.1:55432/kontur_kp_dev
# Роль миграций kontur_migrator — только для npm run db:migrate
DATABASE_MIGRATOR_URL=postgresql://kontur_migrator@127.0.0.1:55432/kontur_kp_dev
# Суперпользователь — только для npm run db:setup
DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:55432/postgres
# Пароли ролей для db:setup (в локальном кластере разработки с trust не нужны)
# KONTUR_APP_DB_PASSWORD=
# KONTUR_MIGRATOR_DB_PASSWORD=
# KONTUR_BACKUP_DB_PASSWORD=

# Корень файлового хранилища (ADR-003), вне репозитория
STORAGE_ROOT=C:/KonturKP/storage

HTTP_HOST=127.0.0.1
# 3200 — чтобы не пересекаться с Quantor (web :3000, admin :3001, api :8000)
HTTP_PORT=3200
# Разрешённые Origin для изменяющих запросов (через запятую). В разработке — сам сервер и Vite.
ALLOWED_ORIGINS=http://127.0.0.1:3200,http://127.0.0.1:5273

# HTTPS для доступа из LAN/VPN (без TLS сервер слушает только 127.0.0.1)
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Наблюдаемые папки допускаются только внутри этих корней (через «;»); без них каналы не сканируются
# INTAKE_ROOTS=C:/KonturKP/intake
# INTAKE_STABILITY_SECONDS=10
# IMPORT_MAX_UPLOAD_MB=512
# IMPORT_MAX_ENTRY_MB=1024
# IMPORT_MAX_ARCHIVE_MB=4096
# IMPORT_MAX_ARCHIVE_ENTRIES=5000
# JOB_LEASE_SECONDS=60

# Пределы разбора экспорта распознавания (этап 04)
# RECOGNITION_MAX_METADATA_MB=64
# RECOGNITION_MAX_METADATA_TOTAL_MB=128
# RECOGNITION_MAX_TEXT_MB=64
# RECOGNITION_MAX_PDF_MB=256
# RECOGNITION_MAX_PAGES=10000

# Поиск портала (этап 05, ADR-012): модель эмбеддингов — только локальный сервер на loopback или в LAN.
# none — модели нет, смысловой поиск честно недоступен; fake — поддельная модель для разработки (не production).
# EMBEDDING_PROVIDER=none
# EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# EMBEDDING_MODEL=
# EMBEDDING_MODEL_REVISION=
# EMBEDDING_API_KEY=
# EMBEDDING_DIM=
# EMBEDDING_INPUT_TEMPLATE=plain
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_BATCH_SIZE=32
# SEARCH_SEMANTIC_DEADLINE_SECONDS=60

# SESSION_IDLE_MINUTES=720
# SESSION_ABSOLUTE_HOURS=168

# Интеграции (этапы 04–16): задаются только в окружении процесса, не в БД и не в сессиях
# TenderHub (этап 06, ADR-007): только чтение официального API по заголовку X-API-Key; ключ — секрет.
# URL — https или http на loopback. Без URL и ключа выгрузка расчёта честно недоступна.
# TENDERHUB_URL=
# TENDERHUB_API_KEY=
# TENDERHUB_TIMEOUT_SECONDS=300
# TENDERHUB_RATE_LIMIT_PER_MINUTE=100
# TENDERHUB_MAX_RESPONSE_MB=512
# TENDERHUB_CAPTURE_ATTEMPTS=3
# MAILHUB_URL=
# MAILHUB_TOKEN=
# YANDEX_DISK_TOKEN=
# SMB_USERNAME=
# SMB_PASSWORD=
